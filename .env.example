PINECONE_API_KEY=replace-with-your-pinecone-api-key
PINECONE_INDEX_NAME=medical-reference-index
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=replace-with-your-auth0-client-id
AUTH0_CLIENT_SECRET=replace-with-your-auth0-client-secret
AUTH0_API_AUDIENCE=https://medica-api.example
AUTH0_CALLBACK_URL=http://127.0.0.1:5000/auth/callback
SESSION_SECRET=replace-with-a-long-random-session-secret
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
TOP_K=3
MIN_RELEVANCE_SCORE=0.25
RETENTION_DAYS=90
PORT=5000